generator client {
  provider = "prisma-client"
  output = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id
  email String @unique
  name String?
  role String
  approvalStatus String @default("approved") @map("approval_status")
  createdAt DateTime @default(now()) @map("created_at")
  classes Class[]
  enrollments Enrollment[]
  createdAssignments Assignment[]
  heartsStates HeartsState[]
  submissions Submission[]
  chatMessages ChatMessage[]
  xpEvents XpEvent[]
  userBadges UserBadge[]
  streak Streak?
  codeDrafts CodeDraft[]
  notifications Notification[]
  posts Post[]
  comments Comment[]

  @@map("users")
}

model Class {
  id String @id @default(uuid())
  name String
  instructorId String @map("instructor_id")
  joinCode String @unique @map("join_code")
  aiProvider String? @map("ai_provider")
  aiApiKeyEnc String? @map("ai_api_key_enc")
  leaderboardSize Int @default(10) @map("leaderboard_size")
  archived Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  assignments AssignmentClass[]
  posts Post[]

  @@map("classes")
}

model Enrollment {
  studentId String @map("student_id")
  classId String @map("class_id")
  archived Boolean @default(false)
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([studentId, classId])
  @@map("enrollments")
}

model Assignment {
  id String @id @default(uuid())
  title String
  instructions String
  language String
  dueDate DateTime @map("due_date")
  heartsCount Int @default(5) @map("hearts_count")
  heartsRegenMinutes Int @default(30) @map("hearts_regen_minutes")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  statsReportNarrative String? @map("stats_report_narrative")
  statsReportGeneratedAt DateTime? @map("stats_report_generated_at")
  instructor User @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  classes AssignmentClass[]
  testCases TestCase[]
  heartsStates HeartsState[]
  submissions Submission[]
  chatMessages ChatMessage[]
  codeDrafts CodeDraft[]

  @@map("assignments")
}

model AssignmentClass {
  assignmentId String @map("assignment_id")
  classId String @map("class_id")
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([assignmentId, classId])
  @@map("assignment_classes")
}

model TestCase {
  id String @id @default(uuid())
  assignmentId String @map("assignment_id")
  input String
  expectedOutput String @map("expected_output")
  visible Boolean
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model HeartsState {
  studentId String @map("student_id")
  assignmentId String @map("assignment_id")
  currentCount Int @map("current_count")
  lastRegenAt DateTime @default(now()) @map("last_regen_at")
  totalSpent Int @default(0) @map("total_spent")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@id([studentId, assignmentId])
  @@map("hearts_states")
}

model Submission {
  id String @id @default(uuid())
  studentId String @map("student_id")
  assignmentId String @map("assignment_id")
  code String
  score Float
  testResults Json @map("test_results")
  behavioralSignals Json @map("behavioral_signals")
  submittedAt DateTime @default(now()) @map("submitted_at")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@map("submissions")
}

model ChatMessage {
  id String @id @default(uuid())
  studentId String @map("student_id")
  assignmentId String @map("assignment_id")
  role String
  content String
  createdAt DateTime @default(now()) @map("created_at")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model XpEvent {
  id String @id @default(uuid())
  studentId String @map("student_id")
  eventType String @map("event_type")
  xpAmount Int @map("xp_amount")
  assignmentId String? @map("assignment_id")
  classId String? @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("xp_events")
}

model Badge {
  id String @id @default(uuid())
  name String @unique
  description String
  condition String
  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId String @map("user_id")
  badgeId String @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Streak {
  studentId String @map("student_id")
  currentStreak Int @default(0) @map("current_streak")
  lastSubmissionWeek Int @default(0) @map("last_submission_week")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId])
  @@map("streaks")
}

model CodeDraft {
  studentId String @map("student_id")
  assignmentId String @map("assignment_id")
  code String
  updatedAt DateTime @updatedAt @map("updated_at")
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@id([studentId, assignmentId])
  @@map("code_drafts")
}

model Post {
  id String @id @default(uuid())
  classId String @map("class_id")
  authorId String @map("author_id")
  type String
  body String?
  linkUrl String? @map("link_url")
  assignmentId String? @map("assignment_id")
  createdAt DateTime @default(now()) @map("created_at")
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@map("posts")
}

model Comment {
  id String @id @default(uuid())
  postId String @map("post_id")
  authorId String @map("author_id")
  body String
  visibility String
  threadStudentId String? @map("thread_student_id")
  createdAt DateTime @default(now()) @map("created_at")
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, visibility])
  @@map("comments")
}

model Notification {
  id String @id @default(uuid())
  userId String @map("user_id")
  type String
  title String
  message String
  link String?
  read Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model SystemSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
